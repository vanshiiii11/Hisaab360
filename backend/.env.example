# ──────────────────────────────────────────────────────────────
# Hisaab360 Backend — Required Environment Variables
# Copy this to .env for local dev. Set all of these in Render.
# ──────────────────────────────────────────────────────────────

# Razorpay API keys (from: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Razorpay webhook secret (from: Razorpay Dashboard → Webhooks → your webhook → Secret)
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXX

# JWT signing secret — generate a strong random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-string

# Your Vercel frontend URL — used for CORS.
# Supports comma-separated values if you have multiple (e.g. preview + production):
#   FRONTEND_URL=https://hisaab360.vercel.app,https://hisaab360-git-main.vercel.app
FRONTEND_URL=http://localhost:5173
